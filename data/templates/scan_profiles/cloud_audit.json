{
  "profile_name": "cloud_audit",
  "display_name": "Cloud Security Audit",
  "description": "Multi-cloud security assessment covering AWS, Azure, GCP configurations and compliance checks",
  "version": "1.0",
  "created_by": "LeZelote Toolkit",
  "last_updated": "2025-08-17",
  "estimated_duration": "1-2 hours",
  "target_types": ["cloud", "aws", "azure", "gcp"],
  "risk_level": "low",
  "stealth_mode": true,
  
  "cloud_providers": {
    "aws": {
      "enabled": true,
      "services": [
        "ec2", "s3", "iam", "rds", "lambda", "cloudtrail",
        "config", "vpc", "security_groups", "cloudformation"
      ]
    },
    "azure": {
      "enabled": true, 
      "services": [
        "virtual_machines", "storage", "active_directory", "sql_database",
        "key_vault", "network_security_groups", "resource_manager"
      ]
    },
    "gcp": {
      "enabled": true,
      "services": [
        "compute", "storage", "iam", "sql", "cloud_functions",
        "vpc", "firewall", "deployment_manager"
      ]
    },
    "kubernetes": {
      "enabled": true,
      "check_clusters": true,
      "check_pods": true,
      "check_services": true
    }
  },
  
  "phases": {
    "reconnaissance": {
      "enabled": true,
      "modules": [
        {
          "name": "cloud_asset_discovery",
          "tool": "cloudasset",
          "options": {
            "enumerate_all_services": true,
            "check_public_resources": true,
            "timeout": 900
          }
        },
        {
          "name": "bucket_enumeration",
          "tool": "s3scanner",
          "options": {
            "check_permissions": true,
            "enumerate_files": false,
            "providers": ["aws", "gcp", "azure"],
            "timeout": 600
          }
        },
        {
          "name": "subdomain_cloud_discovery",
          "tool": "subfinder",
          "options": {
            "cloud_specific": true,
            "sources": ["certificates", "dns"],
            "timeout": 300
          }
        }
      ],
      "parallel_execution": true,
      "max_concurrent": 3
    },
    
    "vulnerability_assessment": {
      "enabled": true,
      "modules": [
        {
          "name": "aws_security_audit",
          "tool": "prowler",
          "options": {
            "checks": ["all"],
            "compliance": ["cis", "gdpr", "hipaa", "pci"],
            "severity": ["critical", "high", "medium"],
            "timeout": 2400
          }
        },
        {
          "name": "azure_security_audit",
          "tool": "scoutsuite",
          "options": {
            "provider": "azure",
            "services": ["all"],
            "compliance_checks": true,
            "timeout": 1800
          }
        },
        {
          "name": "gcp_security_audit",
          "tool": "scoutsuite",
          "options": {
            "provider": "gcp",
            "services": ["all"],
            "compliance_checks": true,
            "timeout": 1800
          }
        },
        {
          "name": "kubernetes_security",
          "tool": "kube-hunter",
          "options": {
            "remote_scanning": true,
            "network_scanning": false,
            "timeout": 900
          }
        },
        {
          "name": "cloud_storage_security",
          "tool": "cloudsploit",
          "options": {
            "all_providers": true,
            "storage_checks": true,
            "iam_checks": true,
            "timeout": 1200
          }
        }
      ],
      "parallel_execution": true,
      "max_concurrent": 2
    },
    
    "exploitation": {
      "enabled": false,
      "reason": "Cloud audit focuses on configuration assessment, not exploitation"
    },
    
    "post_exploitation": {
      "enabled": false,
      "reason": "Cloud audit is read-only assessment"
    },
    
    "reporting": {
      "enabled": true,
      "modules": [
        {
          "name": "cloud_compliance_report",
          "formats": ["html", "pdf", "json"],
          "include_recommendations": true,
          "compliance_mapping": true,
          "executive_summary": true,
          "technical_details": true,
          "cost_analysis": false
        }
      ]
    }
  },
  
  "compliance_frameworks": {
    "cis_benchmarks": {
      "enabled": true,
      "aws_cis": "1.4.0",
      "azure_cis": "1.3.0",
      "gcp_cis": "1.2.0",
      "kubernetes_cis": "1.6.1"
    },
    "regulatory_compliance": {
      "gdpr": true,
      "hipaa": true,
      "pci_dss": true,
      "sox": false,
      "nist": true
    },
    "security_standards": {
      "owasp_cloud_top_10": true,
      "csa_ccm": true,
      "iso_27001": false
    }
  },
  
  "aws_specific_checks": {
    "iam": {
      "root_account_usage": true,
      "access_keys_rotation": true,
      "password_policy": true,
      "mfa_enforcement": true,
      "unused_credentials": true
    },
    "s3": {
      "public_buckets": true,
      "encryption": true,
      "logging": true,
      "versioning": true,
      "lifecycle_policies": false
    },
    "ec2": {
      "security_groups": true,
      "public_instances": true,
      "unencrypted_volumes": true,
      "unused_resources": true
    },
    "network": {
      "vpc_flow_logs": true,
      "open_security_groups": true,
      "nacl_rules": true,
      "route_tables": true
    }
  },
  
  "azure_specific_checks": {
    "identity": {
      "ad_configuration": true,
      "conditional_access": true,
      "privileged_roles": true,
      "guest_users": true
    },
    "storage": {
      "public_containers": true,
      "encryption_at_rest": true,
      "secure_transfer": true,
      "access_policies": true
    },
    "network": {
      "nsg_rules": true,
      "public_ips": true,
      "network_watchers": true,
      "vpn_gateways": false
    }
  },
  
  "gcp_specific_checks": {
    "iam": {
      "service_accounts": true,
      "primitive_roles": true,
      "api_keys": true,
      "audit_logs": true
    },
    "storage": {
      "bucket_permissions": true,
      "uniform_access": true,
      "encryption": true,
      "retention_policies": false
    },
    "compute": {
      "firewall_rules": true,
      "ssh_access": true,
      "serial_port_access": true,
      "disk_encryption": true
    }
  },
  
  "authentication": {
    "aws": {
      "method": "assume_role",
      "credential_source": "environment",
      "session_duration": 3600
    },
    "azure": {
      "method": "service_principal",
      "tenant_id_required": true,
      "subscription_id_required": true
    },
    "gcp": {
      "method": "service_account_json",
      "project_id_required": true,
      "scopes": ["cloud-platform.read-only"]
    }
  },
  
  "performance_settings": {
    "max_threads": 10,
    "memory_limit": "2GB",
    "cpu_limit": "40%",
    "api_rate_limit": "100/minute",
    "scan_intensity": "normal"
  },
  
  "output_options": {
    "verbose": true,
    "save_raw_output": true,
    "compress_results": true,
    "real_time_updates": true,
    "api_response_logging": false
  },
  
  "notification_settings": {
    "critical_findings": true,
    "high_findings": true,
    "compliance_violations": true,
    "completion_notification": true,
    "cost_alerts": false
  },
  
  "safety_measures": {
    "read_only_access": true,
    "no_modifications": true,
    "respect_rate_limits": true,
    "credential_validation": true,
    "permission_check": true
  },
  
  "reporting_options": {
    "executive_dashboard": true,
    "technical_details": true,
    "remediation_priority": true,
    "cost_optimization": false,
    "compliance_status": true,
    "trend_analysis": false
  }
}